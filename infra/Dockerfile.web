# Builds one of the web apps (APP=web for customers, APP=scanner for gate staff) and serves it with nginx,
# proxying /api to the gateway.
FROM node:22-alpine AS build
RUN npm i -g pnpm@12.16.1
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
RUN pnpm install --frozen-lockfile
ARG APP=web
# Demo hints (test cards, the fixed OTP) are on for this university demo. Set to false for anything public.
ARG VITE_DEMO_HINTS=true
ENV VITE_DEMO_HINTS=$VITE_DEMO_HINTS
RUN pnpm --filter @authentix/${APP} build

FROM nginx:1.27-alpine
COPY infra/nginx.web.conf /etc/nginx/conf.d/default.conf
ARG APP=web
COPY --from=build /repo/apps/${APP}/dist /usr/share/nginx/html
