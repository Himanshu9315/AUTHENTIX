{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket.issued",
  "description": "Payload of ticket.issued: tickets were created for a confirmed order. Ids only: no names, emails or QR data.",
  "type": "object",
  "required": [
    "orderId",
    "userId",
    "eventId",
    "ticketIds",
    "issuedAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "ticketIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
