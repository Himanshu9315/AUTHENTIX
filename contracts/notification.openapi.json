{
  "openapi": "3.1.0",
  "info": {
    "title": "Authentix notification-service (in-app inbox)",
    "version": "1.0.0",
    "description": "Everything is scoped to the signed-in user. Another user's notification is 404."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/notifications": {
      "get": {
        "operationId": "listNotifications",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from nextBefore"
          }
        ],
        "responses": {
          "200": {
            "description": "A page, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboxPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad cursor"
          },
          "401": {
            "description": "Not signed in"
          }
        }
      }
    },
    "/notifications/unread-count": {
      "get": {
        "operationId": "unreadCount",
        "responses": {
          "200": {
            "description": "Unread count, capped at 99",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in"
          }
        }
      }
    },
    "/notifications/{id}/read": {
      "post": {
        "operationId": "markRead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Marked read (or already was)"
          },
          "404": {
            "description": "Not yours, or unknown"
          },
          "401": {
            "description": "Not signed in"
          }
        }
      }
    },
    "/notifications/read-all": {
      "post": {
        "operationId": "markAllRead",
        "responses": {
          "204": {
            "description": "All of your notifications are read"
          },
          "401": {
            "description": "Not signed in"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InboxItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "body",
          "link",
          "createdAt",
          "readAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "link": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/(?![/\\\\])\\S*$",
            "description": "App-relative path only"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "InboxPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextBefore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InboxItem"
            }
          },
          "nextBefore": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UnreadCount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unread"
        ],
        "properties": {
          "unread": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        }
      }
    }
  }
}
