{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.email_verification_requested",
  "description": "Payload of the user.email_verification_requested event. The token is a one-time secret; consumers must not log it.",
  "type": "object",
  "required": ["userId", "email", "name", "token"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email" },
    "name": { "type": "string" },
    "token": { "type": "string" }
  },
  "additionalProperties": false
}
