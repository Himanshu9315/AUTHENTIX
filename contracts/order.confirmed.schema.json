{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.confirmed",
  "description": "Payload of order.confirmed: payment succeeded and inventory marked the seats/tickets sold. ticket-service issues tickets from this. Carries no Aadhaar data and no payment instrument data.",
  "type": "object",
  "required": ["orderId", "userId", "eventId", "items", "totalInr", "confirmedAt"],
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "eventId": { "type": "string", "format": "uuid" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tierId", "seatId", "seatLabel", "quantity", "unitPriceInr"],
        "properties": {
          "tierId": { "type": "string", "format": "uuid" },
          "seatId": { "type": ["string", "null"], "format": "uuid" },
          "seatLabel": { "type": ["string", "null"] },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPriceInr": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "totalInr": { "type": "integer", "minimum": 0 },
    "confirmedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
