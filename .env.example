# Copy to .env (git-ignored). All values here are dev-only placeholders.
POSTGRES_USER=authentix
POSTGRES_PASSWORD=change-me-dev-only
RABBITMQ_USER=authentix
RABBITMQ_PASSWORD=change-me-dev-only

# Shared by api-gateway (verify) and auth-service (sign). Use a long random string.
JWT_SECRET=change-me-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Dev only: return the email-verification token in API responses until notification-service exists.
DEV_EXPOSE_VERIFICATION_TOKEN=true

# Keyed-hash secret for Aadhaar numbers (HMAC-SHA256). Server-side only. Changing it orphans every stored hash.
AADHAAR_HASH_SECRET=change-me-at-least-32-characters-long
# Fixed OTP accepted by mock-uidai (dev only, fictional).
MOCK_UIDAI_OTP=123456

# Shared secret for service-to-service /internal/* routes. Never exposed through the gateway.
INTERNAL_TOKEN=change-me-at-least-32-characters-long
# HMAC secret payment-service uses to sign callbacks to booking-service.
PAYMENT_WEBHOOK_SECRET=change-me-at-least-32-characters-long
# How long a seat/ticket hold lasts (seconds). Shorten it to demo hold expiry.
HOLD_TTL_SECONDS=480
